# Vault for SSNs -- environment.
#
# deploy/setup-database.sh copies this to .env (mode 600, never committed) and
# fills in DB_PASSWORD. Read by both systemd services (EnvironmentFile=) and
# by the npm scripts (node --env-file-if-exists=.env).

NODE_ENV=production

# --- Public address ---------------------------------------------------------
DOMAIN=vault.idsservices.us

# --- Backend: the API service (ssn-vault-api) -------------------------------
# Localhost only: nginx is its only client.
HOST=127.0.0.1
PORT=4010
# The frontend is its own service in production; the API answers /api only.
SERVE_FRONTEND=false

# --- Frontend: the web service (ssn-vault-web) ------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=4011

# --- PostgreSQL ---------------------------------------------------------------
# Either the discrete settings below, or one DATABASE_URL, which wins if set:
#   DATABASE_URL=postgres://ssn_vault:PASSWORD@127.0.0.1:5432/ssn_vault
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ssn_vault
DB_USER=ssn_vault
DB_PASSWORD=change-me
DB_POOL_MAX=20
# Only for a remote database that requires TLS. Local sockets/TCP: leave false.
DB_SSL=false

# --- Behind nginx with HTTPS --------------------------------------------------
# Cookies are sent over https only, and the client IP is read from the one
# proxy hop in front (nginx), for rate limiting and the audit trail.
COOKIE_SECURE=true
TRUST_PROXY=1

# --- Sessions and limits --------------------------------------------------------
SESSION_TTL_HOURS=12
RATE_LIMIT_PER_MINUTE=600

# --- First run ------------------------------------------------------------------
# The owner account created on first start. Leave OWNER_PASSWORD unset: a
# one-time password is generated, printed once to the service log, and must be
# changed at first sign-in.
OWNER_EMAIL=owner@example.com
OWNER_NAME=Owner

# Template. deploy/install.sh fills in @APP_DIR@, @APP_USER@ and @NODE_BIN@ and
# installs the result as /etc/systemd/system/ssn-vault-web.service.
[Unit]
Description=SSN Vault web (static frontend, behind nginx at /)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
# Serves public/ only (WEB_HOST/WEB_PORT in .env). No database, no sessions.
ExecStart=@NODE_BIN@ @APP_DIR@/server/frontend.js
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

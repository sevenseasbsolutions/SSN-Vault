{
  "name": "vault-partner-finance",
  "version": "1.0.0",
  "private": true,
  "description": "Partner Payout, Expense & Profit Distribution Management System",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node server/db/migrate.js",
    "seed": "node server/db/seed.js",
    "reset": "node server/db/reset.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:system": "node tests/system-test.mjs",
    "test:watch": "node --test --watch \"tests/*.test.js\"",
    "seed:clear": "node server/db/seed.js --clear"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdfkit": "^0.20.2"
  }
}

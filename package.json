{
  "name": "vault-partner-finance",
  "version": "1.0.0",
  "private": true,
  "description": "Vault for SSNs: company, SSN and share management (PostgreSQL)",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:web": "node --env-file-if-exists=.env server/frontend.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "seed": "node --env-file-if-exists=.env server/db/seed.js",
    "seed:clear": "node --env-file-if-exists=.env server/db/seed.js --clear",
    "reset": "node --env-file-if-exists=.env server/db/reset.js",
    "test": "node --env-file-if-exists=.env.test --test \"tests/*.test.js\"",
    "test:watch": "node --env-file-if-exists=.env.test --test --watch \"tests/*.test.js\"",
    "test:system": "node tests/system-test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3"
  }
}
